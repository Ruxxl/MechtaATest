# Скопируй в .env.local и заполни своими значениями.
# .env.local уже в .gitignore — не попадёт в коммит.
# ВАЖНО: этот файл (.env.local.example) НЕ игнорируется git — сюда реальные
# токены и пароли класть нельзя, только плейсхолдеры.

# Домен Jira Cloud, без протокола и без слэша в конце
JIRA_BASE_URL=your-company.atlassian.net

# Email аккаунта, под которым выпущен API-токен
JIRA_EMAIL=you@company.com

# Atlassian ID -> Security -> API tokens -> Create API token
JIRA_API_TOKEN=

# Ключ проекта, например AS
JIRA_PROJECT_KEY=AS

# Ключ родительской задачи — обязателен (баги создаются только как
# подзадачи). Можно оставить пустым в файле и передавать за раз через
# CLI-флаг --parent AS-XXXX (см. scripts/jira-list-bug-issues.mjs, чтобы
# сначала найти подходящую задачу-контейнер типа "Баг").
JIRA_PARENT_KEY=

# Имя типа задачи в вашей Jira-схеме для подзадач — обычно "Подзадача"
# или "Sub-task", проверьте в самой Jira (Настройки проекта -> Типы задач).
JIRA_ISSUE_TYPE=Подзадача
